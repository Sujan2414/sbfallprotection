---
import Base from '../layouts/Base.astro';
---
<Base title="SB Fall Protection — Certified Fall Protection Manufacturer, Kanpur India" home={true}>
<!-- ============ HERO ============ -->
<header class="hero" id="top">
  <img class="hero-img" src="/assets/hero-harness.jpg" alt="Worker wearing SB full body harness on a construction site at sunrise">
  <div class="hero-shade"></div>
  <div class="wrap hero-in">
    <span class="hero-badge">ISO 9001:2015 Certified Manufacturer</span>
    <h1>Certified Fall Protection Gear You Can Trust</h1>
    <p class="hero-desc">From full body harnesses to complete rescue kits, we manufacture and export certified height-safety equipment — engineered, tested and packed in our 145,000 sq ft facility in Kanpur, India.</p>
    <div class="hero-btns">
      <a class="btn btn-orange" href="#contact">Get Your Free Quote</a>
      <a class="btn btn-white" href="tel:+915122406728">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z"/></svg>
        Call Now</a>
    </div>
    <div class="hero-rev">
      <div class="avs">
        <img src="/assets/avatar-1.jpg" alt=""><img src="/assets/avatar-2.jpg" alt=""><img src="/assets/avatar-3.jpg" alt=""><img src="/assets/avatar-4.jpg" alt="">
      </div>
      <div class="rev-meta">
        <div class="stars">★★★★★</div>
        <div class="line2"><b>4.9+</b>500+ customers worldwide</div>
      </div>
    </div>
  </div>
</header>

<!-- ============ STATS ============ -->
<section class="stats">
  <div class="wrap">
    <div class="stats-card reveal">
      <div class="stats-g">
        <div class="stat"><div class="num"><span data-count="20">0</span><i>+</i></div><small>Years of Experience</small></div>
        <div class="stat"><div class="num"><span data-count="460">0</span><i>+</i></div><small>Product Types</small></div>
        <div class="stat"><div class="num"><span data-count="500">0</span><i>+</i></div><small>Global Customers</small></div>
        <div class="stat"><div class="num"><span data-count="290">0</span><i>+</i></div><small>Skilled Professionals</small></div>
      </div>
    </div>
  </div>
</section>

<!-- ============ SERVICES / PRODUCTS ============ -->
<section class="sec services" id="products">
  <div class="wrap">
    <div class="sec-head left reveal">
      <span class="label">Our Products</span>
      <h2>Protection Systems<br>Built <em>Around You</em></h2>
      <p>From body support to anchorage and rescue, every product is designed, manufactured and tested under one roof — ready for your site or your shelf.</p>
    </div>
    <div class="svc-g">
      <figure class="svc-card reveal" style="margin:0">
        <div class="ph"><img src="/assets/prod-harness.jpg" alt="SB full body harness, front and back view">
          <span class="svc-ic"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="4" r="2"/><path d="M8 8h8l-1.2 6.5h-5.6L8 8Z"/><path d="m9 8-2 12M15 8l2 12M9.2 11.5h5.6"/><circle cx="12" cy="17.5" r="1.6"/></svg></span></div>
        <figcaption class="svc-body">
          <h3>Full Body Harnesses</h3>
          <p>Premium-series harnesses with quick-connect buckles and breathable padding, engineered for comfort through full shifts at height.</p>
          <div class="svc-foot">
            <a class="svc-link" href="#contact">Get a Quote</a>
            <a class="svc-go" href="#contact" aria-label="Get a quote">
              <svg class="a1" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16M13 5l7 7-7 7"/></svg>
              <svg class="a2" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16M13 5l7 7-7 7"/></svg>
            </a>
          </div>
        </figcaption>
      </figure>
      <figure class="svc-card reveal" style="margin:0">
        <div class="ph"><img src="/assets/prod-lanyard.jpg" alt="SB twin-leg energy-absorbing lanyard">
          <span class="svc-ic"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3v3M6 6c0 4 4 3 4 7 0 2.5-2 3-2 5"/><path d="M8 18c0 1.7 1.3 3 3 3s3-1.3 3-3-1.3-3-3-3"/><path d="M14 6.5 18 3M15.5 8l4-3.5"/></svg></span></div>
        <figcaption class="svc-body">
          <h3>Lanyards &amp; Energy Absorbers</h3>
          <p>Single and twin-leg webbing or rope lanyards with shock absorbers that cap arrest forces before they reach the body.</p>
          <div class="svc-foot">
            <a class="svc-link" href="#contact">Get a Quote</a>
            <a class="svc-go" href="#contact" aria-label="Get a quote">
              <svg class="a1" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16M13 5l7 7-7 7"/></svg>
              <svg class="a2" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16M13 5l7 7-7 7"/></svg>
            </a>
          </div>
        </figcaption>
      </figure>
      <figure class="svc-card reveal" style="margin:0">
        <div class="ph"><img src="/assets/prod-arrester.jpg" alt="SB guided fall arrester with carabiner">
          <span class="svc-ic"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.5a7 7 0 1 1-7 7"/><path d="M12 5.8a3.7 3.7 0 1 0 3.7 3.7"/><path d="M12 13.2v5"/><circle cx="12" cy="20" r="1.8"/></svg></span></div>
        <figcaption class="svc-body">
          <h3>Fall Arresters &amp; Rope Grabs</h3>
          <p>Guided-type fall arresters that travel the lifeline with the worker — and lock the instant a fall begins.</p>
          <div class="svc-foot">
            <a class="svc-link" href="#contact">Get a Quote</a>
            <a class="svc-go" href="#contact" aria-label="Get a quote">
              <svg class="a1" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16M13 5l7 7-7 7"/></svg>
              <svg class="a2" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16M13 5l7 7-7 7"/></svg>
            </a>
          </div>
        </figcaption>
      </figure>
      <figure class="svc-card reveal" style="margin:0">
        <div class="ph"><img src="/assets/prod-lifeline.jpg" alt="SB horizontal lifeline kit with anchorage strap">
          <span class="svc-ic"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h16M6 20v-3h12v3"/><circle cx="12" cy="9" r="4"/><path d="M12 13v4"/></svg></span></div>
        <figcaption class="svc-body">
          <h3>Anchorages &amp; Lifelines</h3>
          <p>Fixed and temporary anchor points, slings and horizontal lifelines that give every system a certified place to hold.</p>
          <div class="svc-foot">
            <a class="svc-link" href="#contact">Get a Quote</a>
            <a class="svc-go" href="#contact" aria-label="Get a quote">
              <svg class="a1" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16M13 5l7 7-7 7"/></svg>
              <svg class="a2" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16M13 5l7 7-7 7"/></svg>
            </a>
          </div>
        </figcaption>
      </figure>
      <figure class="svc-card reveal" style="margin:0">
        <div class="ph"><img src="/assets/prod-hook.jpg" alt="SB forged steel snap hook">
          <span class="svc-ic"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.8c3.8 0 6.5 3 6.5 7.2s-2.7 11.2-6.5 11.2S5.5 14.2 5.5 10 8.2 2.8 12 2.8Z"/><path d="m16.6 6.2 1.9 2.6"/><path d="M8.5 10.5v3.5"/></svg></span></div>
        <figcaption class="svc-body">
          <h3>Hooks &amp; Connectors</h3>
          <p>Forged snap hooks, scaffold hooks and carabiners — load-rated, gate-tested and corrosion-protected.</p>
          <div class="svc-foot">
            <a class="svc-link" href="#contact">Get a Quote</a>
            <a class="svc-go" href="#contact" aria-label="Get a quote">
              <svg class="a1" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16M13 5l7 7-7 7"/></svg>
              <svg class="a2" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16M13 5l7 7-7 7"/></svg>
            </a>
          </div>
        </figcaption>
      </figure>
      <figure class="svc-card reveal" style="margin:0">
        <div class="ph"><img src="/assets/prod-garment.jpg" alt="SB hi-visibility safety coverall">
          <span class="svc-ic"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M9 4 5 6v14h14V6l-4-2-1 2h-4L9 4Z"/><path d="M5 11h14M5 15h14"/></svg></span></div>
        <figcaption class="svc-body">
          <h3>Safety Garments &amp; PPE</h3>
          <p>Hi-visibility workwear and head-to-toe personal protective equipment to complete every kit you supply.</p>
          <div class="svc-foot">
            <a class="svc-link" href="#contact">Get a Quote</a>
            <a class="svc-go" href="#contact" aria-label="Get a quote">
              <svg class="a1" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16M13 5l7 7-7 7"/></svg>
              <svg class="a2" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16M13 5l7 7-7 7"/></svg>
            </a>
          </div>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<!-- ============ WHY ============ -->
<section class="sec" id="why">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="label">Why Choose Us</span>
      <h2>Why Global Buyers Trust Our Gear</h2>
      <p>We combine in-house manufacturing, certified quality systems and design-led engineering to deliver equipment your crews can stake their lives on.</p>
    </div>
    <div class="why-g">
      <div class="why-col">
        <div class="why-card reveal">
          <div class="why-ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4.5 6v5c0 4.8 3.2 8.5 7.5 10 4.3-1.5 7.5-5.2 7.5-10V6L12 3Z"/><path d="m9 12 2 2 4-4.5"/></svg></div>
          <h3>Certified &amp; Audited</h3>
          <p>ISO 9001:2015 quality systems and SEDEX-audited ethical production, with test documentation available for every batch.</p>
        </div>
        <div class="why-card reveal">
          <div class="why-ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 21h16M6 21V9l6-5 6 5v12M10 21v-6h4v6"/></svg></div>
          <h3>In-House Manufacturing</h3>
          <p>Webbing, stitching, hardware and packing run under one 145,000 sq ft roof — no outsourced steps, no blind spots.</p>
        </div>
      </div>
      <figure class="why-img reveal" style="margin:0">
        <img src="/assets/why-tower.jpg" alt="Technicians in harnesses working on a telecom tower">
        <figcaption>Trusted by 500+ businesses &amp; crews worldwide</figcaption>
      </figure>
      <div class="why-col">
        <div class="why-card reveal">
          <div class="why-ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M5.6 18.4l2.1-2.1M16.3 7.7l2.1-2.1"/><circle cx="12" cy="12" r="3.2"/></svg></div>
          <h3>Design-Led Engineering</h3>
          <p>Qualified designers and pattern masters develop lighter, faster-donning gear — including custom builds to your exact spec.</p>
        </div>
        <div class="why-card reveal">
          <div class="why-ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3.5 9h17M3.5 15h17M12 3c-2.5 2.4-4 5.4-4 9s1.5 6.6 4 9c2.5-2.4 4-5.4 4-9s-1.5-6.6-4-9Z"/></svg></div>
          <h3>Export-Grade Delivery</h3>
          <p>A Government of India recognised Export House shipping to the USA and markets worldwide on committed lead times.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============ VIDEO ============ -->
<section class="sec" style="padding-top:0">
  <div class="wrap">
    <div class="video-blk reveal">
      <video src="/assets/showreel.mp4" poster="assets/video-poster.jpg" autoplay muted loop playsinline aria-label="Abstract animation of swaying orange lifelines"></video>
      <span class="video-cap">Always protect like a shield — SB Fall Protection</span>
    </div>
  </div>
</section>

<!-- ============ HOW IT WORKS ============ -->
<section class="sec" id="works" style="padding-top:24px">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="label">How It Works</span>
      <h2>From Your Spec to Shipped</h2>
      <p>From first enquiry to final dispatch — our process is built to be clear, fast and dependable.</p>
    </div>
    <div class="works-g">
      <div class="step reveal">
        <span class="n">STEP 01</span>
        <h3>Share Your Requirement</h3>
        <p>Send a product list or a custom spec online, or give our sales team a call.</p>
      </div>
      <div class="step reveal">
        <span class="n">STEP 02</span>
        <h3>Design &amp; Prototype</h3>
        <p>Our in-house designers turn your requirement into patterns and samples.</p>
      </div>
      <div class="step reveal">
        <span class="n">STEP 03</span>
        <h3>Manufacture &amp; Test</h3>
        <p>Production runs fully in-house with stringent batch-level quality control.</p>
      </div>
      <div class="step reveal">
        <span class="n">STEP 04</span>
        <h3>Pack &amp; Ship Worldwide</h3>
        <p>Finishing, export documentation and dispatch — handled end to end.</p>
      </div>
    </div>
  </div>
</section>

<!-- ============ URGENT CTA ============ -->
<section class="sec" style="padding-top:12px">
  <div class="wrap">
    <div class="urgent reveal">
      <span class="u-dots ud-tr" aria-hidden="true"></span>
      <span class="u-dots ud-bl" aria-hidden="true"></span>
      <div class="urgent-copy">
        <span class="u-badge"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 18v-6a5 5 0 0 1 10 0v6"/><path d="M5 18h14v2H5v-2Z"/><path d="M12 3v2M4.5 6.5 6 8M19.5 6.5 18 8"/></svg> Urgent Requirement</span>
        <h2>Need Certified Gear on a Deadline?</h2>
        <p class="sub"><span class="u-clock"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/></svg></span> Sales team available Mon – Sat, 9:00 – 18:00 IST</p>
        <a class="btn btn-white" href="tel:+915122406728">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z"/></svg>
          Call Now <span class="arr">→</span></a>
      </div>
      <div class="urgent-photo"><div class="u-circle"><img src="/assets/urgent-worker.jpg" alt="SB worker wearing hi-visibility safety gear"></div></div>
    </div>
  </div>
</section>

<!-- ============ FEATURED ============ -->
<section class="sec" id="featured" style="padding-top:12px">
  <div class="wrap">
    <div class="sec-head left reveal">
      <span class="label">Inside the Factory</span>
      <h2>See How Your Gear Is <em>Made</em></h2>
      <p>A look inside our 145,000 sq ft facility in Kanpur — from webbing and stitching to final inspection and packing, every step happens in-house.</p>
    </div>
  </div>
  <div class="reveal">
    <div class="fac-track" id="facTrack">
      <figure class="fac-card">
        <img src="/assets/fac-stitching.jpg" alt="Rows of specialists stitching webbing on the SB production floor">
        <figcaption>The stitching floor — 290+ specialists</figcaption>
      </figure>
      <figure class="fac-card">
        <img src="/assets/fac-cutting.jpg" alt="Worker cutting and heat-sealing orange webbing">
        <figcaption>Webbing cutting &amp; heat-sealing</figcaption>
      </figure>
      <figure class="fac-card">
        <img src="/assets/fac-inspection.jpg" alt="Team inspecting and packing finished harness webbing">
        <figcaption>Inspection &amp; packing</figcaption>
      </figure>
      <figure class="fac-card">
        <img src="/assets/fac-campus.jpg" alt="SB International factory campus in Kanpur">
        <figcaption>SB International — Kanpur campus</figcaption>
      </figure>
      <figure class="fac-card">
        <img src="/assets/fac-building.jpg" alt="SB International headquarters building">
        <figcaption>Head office &amp; design studio</figcaption>
      </figure>
    </div>
  </div>
</section>

<!-- ============ TESTIMONIALS ============ -->
<section class="sec testi" id="testimonials">
  <img class="testi-deco deco-l" src="/assets/deco-carabiner.png" alt="" aria-hidden="true">
  <img class="testi-deco deco-r" src="/assets/deco-hook.png" alt="" aria-hidden="true">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="label">Testimonials</span>
      <h2>Hear From Our <em>Happy Customers</em></h2>
      <p>See what buyers say about our consistency, product quality and export reliability.</p>
    </div>
    <div class="t-card reveal" id="tCard">
      <div class="t-photo"><img id="tPhoto" src="/assets/slide-a.jpg" alt="SB Fall Protection at work"></div>
      <div class="t-content">
        <div class="t-rating"><span class="stars">★★★★★</span><b>4.9/5</b></div>
        <p class="t-trusted">Trusted by 500+ Happy Customers</p>
        <p class="t-quote" id="tQuote"></p>
        <div class="t-who">
          <b id="tName"></b>
          <span id="tRole"></span>
        </div>
        <div class="t-avatars" id="tAvatars"></div>
      </div>
    </div>
    <div class="t-nav reveal">
      <button class="t-arrow" id="tPrev" aria-label="Previous testimonial"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg></button>
      <button class="t-arrow" id="tNext" aria-label="Next testimonial"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6"/></svg></button>
    </div>
  </div>
</section>

<!-- ============ EXPORT MARKETS ============ -->
<section class="sec" id="markets">
  <div class="wrap mkt-g">
    <div class="reveal">
      <div class="sec-head left" style="margin-bottom:0">
        <span class="label">Export Markets</span>
        <h2>Proudly Serving Customers Worldwide</h2>
        <p>From our facility in Kanpur, India, we supply distributors, EPC contractors and safety companies across six continents — with the United States as our largest market.</p>
      </div>
      <div class="mkt-note">
        <b>Don't see your region?</b>
        <span>We ship worldwide — contact us today and we'll be happy to help.</span>
      </div>
    </div>
