---
import { getContact, tel, waLink, addressLines, addressOneLine, phones } from '../../lib/contact';
const ct = await getContact();
import { Fragment } from 'astro/jsx-runtime';
import { existsSync } from 'node:fs';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import {
  getCategories, getCategory, getFamilies, getProducts,
  productUrl, imageUrl, categoryUrl,
} from '../../lib/catalog';

export function getStaticPaths() {
  return getCategories().map((c) => ({ params: { category: c.slug } }));
}

const { category } = Astro.params;
/* a category added in the panel has no stock header photo, so use its own or the generic one */
const heroFor = (slug: string, own?: string) =>
  existsSync(`public/assets/hero-${slug}.jpg`) ? slug : (own || 'products');
const cat = getCategory(category!)!;
const families = getFamilies(category!);
const products = getProducts(category!);

/** Columns for a range shown as a table: its spec keys, else its attachment. */
function columnsOf(items: { specs: Record<string, string>; attachment: string | null }[]): string[] {
  const keys: string[] = [];
  for (const p of items) for (const k of Object.keys(p.specs)) if (!keys.includes(k)) keys.push(k);
  if (keys.length) return keys.slice(0, 8);
  return items.some((p) => p.attachment) ? ['Details'] : [];
}

/** One photo for the whole range, when every code shares it. */
function sharedPhoto(items: { image: string | null }[]): string | null {
  const set = new Set(items.map((p) => p.image));
  return set.size === 1 ? (items[0].image ?? null) : null;
}

/** Every standard a product carries, for the card badge. */
function stdOf(specs: Record<string, string>): string | null {
  const key = Object.keys(specs).find((k) => /standard|conformity|conforms/i.test(k));
  if (!key) return null;
  const v = String(specs[key] || '').trim();
  if (!v || /not applicable/i.test(v)) return null;
  return v;
}

/*
 * Categories that open on a choice between ranges. Lanyards come in an EN range
 * and an ANSI range, and the client wants that choice to be the first thing
 * seen. Without JavaScript every range simply shows, one after another.
 */
const SPLITS: Record<string, { key: string; label: string; blurb: string; has: (slug: string) => boolean }[]> = {
  lanyards: [
    { key: 'en', label: 'EN Range Lanyards',
      blurb: 'Forked and single lanyards in webbing, twisted rope and kernmantle rope, certified to EN 355 and EN 354.',
      has: (s) => s !== 'ansi-lanyards' },
    { key: 'ansi', label: 'ANSI Range Lanyards',
      blurb: 'Lanyards with shock absorbers for the North American market, certified to ANSI Z359.13.',
      has: (s) => s === 'ansi-lanyards' },
  ],
};
const split = SPLITS[category!] ?? null;
const rangeOf = (slug: string) => (split ? split.find((r) => r.has(slug))?.key : undefined);
---
<Base
  title={`${cat.name} — SB Fall Protection`}
  description={`${cat.name} manufactured by SB Fall Protection, Kanpur India. ${cat.blurb} ${products.length} products available with full specifications.`}
>
  <PageHeader
    eyebrow="Product Range"
    title={cat.name}
    lead={cat.blurb}
    crumbs={[{ label: 'Products', href: '/products' }, { label: cat.name }]}
    image={heroFor(cat.slug, cat.image)}
    imageAlt={`${cat.name} in use on site`}
  />

  <section class="sec">
    <div class="wrap">
      {cat.intro && cat.intro !== cat.blurb && !families.some((f) => f.intro === cat.intro) && (
        <p class="cat-intro">{cat.intro}</p>
      )}
      {split && (
        <div class="range-pick" data-range-pick>
          {split.map((r) => (
            <a class="range-card" href={`#${r.key}`} data-range-btn={r.key}>
              <span class="range-card-label">{r.label}</span>
              <span class="range-card-blurb">{r.blurb}</span>
              <span class="range-card-count">
                {products.filter((p) => r.has(p.family)).length} products
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </span>
            </a>
          ))}
        </div>
      )}
      {families.map((f) => {
        const items = getProducts(category!, f.slug);
        if (items.length === 0) return null;
        return (
          <div class="family" id={`fam-${f.slug}`} data-range={rangeOf(f.slug)}>
            <div class="family-head">
              <div>
                <h2>{f.name}</h2>
                {f.intro && <p>{f.intro}</p>}
              </div>
              <span class="family-tag">{items.length} {items.length === 1 ? 'product' : 'products'}</span>
            </div>

            {f.bullets.length > 0 && (
              <div class="fam-notes">
                <ul>
                  {f.bullets.map((b) => <li>{b}</li>)}
                </ul>
              </div>
            )}

            {f.layout === 'table' ? (
              <Fragment>
                {sharedPhoto(items) && (
                  <a class="fam-photo fam-zoom" href={imageUrl(sharedPhoto(items))} target="_blank" rel="noopener"
                     aria-label={`Open the ${f.name} photo`}>
                    <img src={imageUrl(sharedPhoto(items))} alt={f.name} loading="lazy" width="420" height="420">
                  </a>
                )}
                <div class="fam-table-wrap">
                  <table class="fam-table">
                    <thead>
                      <tr>
                        <th>Ref. No.</th>
                        {!sharedPhoto(items) && <th class="fam-th-img"><span class="vh">Photo</span></th>}
                        {columnsOf(items).map((k) => <th>{k}</th>)}
                      </tr>
                    </thead>
                    <tbody>
                      {items.map((p) => (
                        <tr>
                          <td class="fam-ref">{p.sku}</td>
                          {!sharedPhoto(items) && (
                            <td class="fam-td-img">
                              <a class="fam-zoom" href={imageUrl(p.image)} target="_blank" rel="noopener"
                                 aria-label={`Open the ${p.sku} photo`}>
                                <img src={imageUrl(p.image)} alt={p.sku} loading="lazy" width="150" height="100">
                              </a>
                            </td>
                          )}
                          {columnsOf(items).map((k) => (
                            <td>{k === 'Details' ? (p.attachment ?? '') : (p.specs[k] ?? '')}</td>
                          ))}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </Fragment>
            ) : (
            <div class="sku-grid">
              {items.map((p) => (
                <a class="sku-card" href={productUrl(p)}>
                  <span class="sku-ph">
                    <img src={imageUrl(p.image)} alt={`${p.sku} — ${f.name}`} loading="lazy" width="300" height="300">
                  </span>
                  <span class="sku-body">
                    <span class="sku-code">{p.sku}</span>
                    {(p.attachment || p.specs['Type'] || p.specs['Uses'] || p.specs['Usage']) && (
                      <span class="sku-desc">{p.attachment || p.specs['Type'] || p.specs['Uses'] || p.specs['Usage']}</span>
                    )}
                    <span class="sku-foot">
                      {stdOf(p.specs)
                        ? <span class="sku-std">{stdOf(p.specs)}</span>
                        : <span class="sku-std">View specs</span>}
                      <span class="sku-arrow">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                      </span>
                    </span>
                  </span>
                </a>
              ))}
            </div>
            )}
          </div>
        );
      })}
    </div>
  </section>

  <section class="sec" style="padding-top:0">
    <div class="wrap">
      <div class="cta-card reveal">
        <img class="cta-bg" src="/assets/cta-abstract.jpg" alt="">
        <div class="cta-inner">
          <h2>Need a quote on {cat.name}?</h2>
          <p>Send us the product codes and quantities you need — we reply with specifications, MOQs and pricing within one business day.</p>
          <div class="btns">
            <a class="btn btn-orange" href="/contact">Request a Quote</a>
            <a class="btn btn-white" href={tel(ct.phone)}>Call Now</a>
          </div>
        </div>
      </div>
    </div>
  </section>
  <script is:inline>
    (function () {
      /* EN / ANSI choice: the hash picks the range, EN by default */
      var pick = document.querySelector('[data-range-pick]');
      if (pick) {
        var fams = [].slice.call(document.querySelectorAll('.family[data-range]'));
        var btns = [].slice.call(pick.querySelectorAll('[data-range-btn]'));
        var keys = btns.map(function (b) { return b.getAttribute('data-range-btn'); });
        var show = function () {
          var k = location.hash.slice(1);
          if (keys.indexOf(k) < 0) {
            // a link to one range (#fam-...) opens the side that holds it
            var el = k && document.getElementById(k);
            var host = el && el.closest('.family[data-range]');
            k = host ? host.getAttribute('data-range') : keys[0];
          }
          fams.forEach(function (f) { f.hidden = f.getAttribute('data-range') !== k; });
          btns.forEach(function (b) {
            var on = b.getAttribute('data-range-btn') === k;
            b.classList.toggle('on', on);
            b.setAttribute('aria-current', on ? 'true' : 'false');
          });
        };
        window.addEventListener('hashchange', show);
        show();
      }

      /* table photos: a large preview follows the pointer; a click opens the full image */
      if (!window.matchMedia('(hover: hover)').matches) return;
      var box = document.createElement('div');
      box.className = 'fam-preview';
      box.innerHTML = '<img alt="">';
      document.body.appendChild(box);
      var img = box.firstChild;
      document.querySelectorAll('.fam-td-img .fam-zoom').forEach(function (a) {
        a.addEventListener('mouseenter', function () { img.src = a.href; box.classList.add('on'); });
        a.addEventListener('mouseleave', function () { box.classList.remove('on'); });
        a.addEventListener('mousemove', function (e) {
          var w = 380, x = e.clientX + 24, y = e.clientY - w / 2;
          if (x + w > innerWidth - 12) x = e.clientX - w - 24;
          y = Math.max(12, Math.min(y, innerHeight - w - 12));
          box.style.transform = 'translate(' + x + 'px,' + y + 'px)';
        });
      });
    })();
  </script>
</Base>
