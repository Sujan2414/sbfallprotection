---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { getAbout } from '../lib/content';

// edited under About Us in the admin panel
const ab = await getAbout();
const { figures, leadership, certs, recognitions } = ab;
---
<Base
  title="About SB Fall Protection — Manufacturer & Exporter Since 2003"
  description="SB International, established 2003 in Kanpur India, manufactures and exports certified fall-protection and PPE. ISO 9001:2015 certified, SEDEX audited, Government of India recognised Export House."
>
  <PageHeader
    eyebrow="About Our Company"
    title="Built on Trust."
    accent="Driven by Quality."
    lead={ab.heroLead}
    crumbs={[{ label: 'About' }]}
    image="about"
    imageAlt="Stitching floor at the SB International facility in Kanpur"
  />

  <section class="sec">
    <div class="wrap about-g">
      <div class="about-fig reveal">
        <img class="main" src={ab.photo} alt="SB stitching floor in Kanpur, staff working with orange harness webbing" width="760" height="836">
        <div class="float-card fc-a"><div class="big">{ab.years}</div><small>Years of Experience</small></div>
        <div class="float-card fc-b"><div class="big">{ab.badge}</div><small>{ab.badgeNote}</small></div>
      </div>
      <div class="reveal">
        <p class="ab-lead">{ab.quote}</p>
        <div class="ab-body">
          {ab.paragraphs.map((p) => <p>{p}</p>)}
        </div>
        <div class="cert-strip">
          <span class="cert-chip">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4.5 6v5c0 4.8 3.2 8.5 7.5 10 4.3-1.5 7.5-5.2 7.5-10V6L12 3Z"/><path d="m9 12 2 2 4-4.5"/></svg>
            ISO 9001:2015
          </span>
          <span class="cert-chip">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h16M6 20V9l6-5 6 5v11"/><path d="M10 20v-6h4v6"/></svg>
            SEDEX Audited
          </span>
          <span class="cert-chip">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M3.5 9h17M3.5 15h17M12 3c-2.5 2.4-4 5.4-4 9s1.5 6.6 4 9c2.5-2.4 4-5.4 4-9s-1.5-6.6-4-9Z"/></svg>
            Govt. Recognised Export House
          </span>
        </div>
      </div>
    </div>
  </section>

  <section class="sec" style="padding-top:0">
    <div class="wrap">
      <div class="ab-figures">
        {figures.map((f) => (
          <div class="ab-fig reveal"><b>{f.n}</b><span>{f.l}</span></div>
        ))}
      </div>
    </div>
  </section>

  <section class="sec services">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="label">Leadership</span>
        <h2>The People Behind <em>the Product</em></h2>
      </div>
      <div class="team-grid">
        {leadership.map((p) => (
          <div class="team-card reveal">
            <img class="team-photo" src={p.photo} alt={p.name} width="300" height="300" loading="lazy">
            <b>{p.name}</b><em>{p.role}</em>
            <p>{p.bio}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="label">Certifications</span>
        <h2>Audited, Certified, <em>On Record</em></h2>
        <p>Every claim on this site is backed by a certificate you can ask us for.</p>
      </div>

      <div class="cert-grid">
        {certs.map((c) => (
          <div class="cert-card reveal">
            <span class="cert-mark"><img src={c.logo} alt={c.alt || c.name} loading="lazy"></span>
            <div class="cert-text">
              <b>{c.name}</b>
              <p>{c.note}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="cert-rec">
        {recognitions.map((r) => (
          <div class="cert-badge reveal">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="9"/></svg>
            <span><b>{r.name}</b><em>{r.note}</em></span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="sec" style="padding-top:0">
    <div class="wrap">
      <div class="sec-head left reveal">
        <span class="label">Inside the Factory</span>
        <h2>One Roof. <em>Zero Compromises.</em></h2>
        <p>From webbing and stitching to final inspection and packing, every step happens in-house.</p>
      </div>
    </div>
    <div class="reveal">
      <div class="fac-track" id="facTrack">
        <figure class="fac-card">
          <img src="/assets/fac-cutting.jpg" alt="Webbing cutting and heat-sealing" width="840" height="650">
          <figcaption>Webbing cutting &amp; heat-sealing</figcaption>
        </figure>
        <figure class="fac-card">
          <img src="/assets/fac-inspection.jpg" alt="Inspection and packing" width="646" height="457">
          <figcaption>Inspection &amp; packing</figcaption>
        </figure>
        <figure class="fac-card">
          <img src="/assets/fac-campus.jpg" alt="SB International factory campus in Kanpur" width="1000" height="577">
          <figcaption>SB International — Kanpur campus</figcaption>
        </figure>
        <figure class="fac-card">
          <img src="/assets/fac-building.jpg" alt="Head office and design studio" width="800" height="530">
          <figcaption>Head office &amp; design studio</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="sec" style="padding-top:12px">
    <div class="wrap">
      <div class="cta-card reveal">
        <img class="cta-bg" src="/assets/cta-abstract.jpg" alt="">
        <div class="cta-inner">
          <h2>Ready to Equip Your Crew?</h2>
          <p>From single product lines to complete fall-protection programmes, our team delivers certified gear you can trust.</p>
          <div class="btns">
            <a class="btn btn-orange" href="/contact">Get Free Quote</a>
            <a class="btn btn-white" href="/products">Browse Products</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
