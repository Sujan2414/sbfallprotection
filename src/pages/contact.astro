---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import QuoteFlow from '../components/QuoteFlow.astro';
---
<Base
  title="Contact SB Fall Protection — Request a Quote"
  description="Contact SB Fall Protection in Kanpur, India for quotations, specifications and MOQs on certified fall-protection equipment and PPE. Phone +91 512 240 6728, sales@sbfallprotection.com."
>
  <PageHeader
    eyebrow="Contact Us"
    title="Get in Touch"
    accent="Today"
    lead="Planning an order or need a custom build? Send your requirement and our sales team responds with specifications, MOQs and pricing within one business day."
    crumbs={[{ label: 'Contact' }]}
    image="contact"
    imageAlt="SB International head office and factory in Kanpur, India"
  />

  <section class="sec">
    <div class="wrap ct-grid">
      <div class="reveal">
        <div class="ct-card">
          <div class="ct-item">
            <span class="ct-ic"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z"/></svg></span>
            <div>
              <b>Phone</b>
              <a href="tel:+915122406728">+91 512 240 6728</a>
              <a href="tel:+915122406947">+91 512 240 6947</a>
            </div>
          </div>
          <div class="ct-item">
            <span class="ct-ic"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg></span>
            <div>
              <b>Email</b>
              <a href="mailto:sales@sbfallprotection.com">sales@sbfallprotection.com</a>
            </div>
          </div>
          <div class="ct-item">
            <span class="ct-ic"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 21s-7-5.6-7-11a7 7 0 0 1 14 0c0 5.4-7 11-7 11Z"/><circle cx="12" cy="10" r="2.5"/></svg></span>
            <div>
              <b>Factory &amp; Office</b>
              <span>Plot C-17 to C-19, UPSIDC Industrial Area,<br>Textile Zone, Rooma, Kanpur — 208008,<br>Uttar Pradesh, India</span>
            </div>
          </div>
          <div class="ct-item">
            <span class="ct-ic"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/></svg></span>
            <div>
              <b>Business Hours</b>
              <span>Monday – Saturday, 9:00 – 18:00 IST</span>
            </div>
          </div>
        </div>

        <iframe
          class="ct-map"
          title="SB Fall Protection location, Rooma, Kanpur"
          src="https://www.google.com/maps?q=Kanpur%2C%20Uttar%20Pradesh%2C%20India&z=12&output=embed"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>

      <div class="reveal flow-col">
        <QuoteFlow />
      </div>
    </div>
  </section>
</Base>
