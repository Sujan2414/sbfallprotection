---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { getCategories } from '../lib/catalog';

const categories = getCategories();
---
<Base
  title="Contact SB Fall Protection — Request a Quote"
  description="Contact SB Fall Protection in Kanpur, India for quotations, specifications and MOQs on certified fall-protection equipment and PPE. Phone +91 512 240 6728, sales@sbfallprotection.com."
>
  <PageHeader
    eyebrow="Contact Us"
    title="Get in Touch"
    accent="Today"
    lead="Planning an order or need a custom build? Send your requirement and our sales team responds with specifications, MOQs and pricing within one business day."
    crumbs={[{ label: 'Contact' }]}
  />

  <section class="sec">
    <div class="wrap ct-grid">
      <div class="reveal">
        <div class="ct-card">
          <div class="ct-item">
            <span class="ct-ic"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z"/></svg></span>
            <div>
              <b>Phone</b>
              <a href="tel:+915122406728">+91 512 240 6728</a>
              <a href="tel:+915122406947">+91 512 240 6947</a>
            </div>
          </div>
          <div class="ct-item">
            <span class="ct-ic"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg></span>
            <div>
              <b>Email</b>
              <a href="mailto:sales@sbfallprotection.com">sales@sbfallprotection.com</a>
            </div>
          </div>
          <div class="ct-item">
            <span class="ct-ic"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 21s-7-5.6-7-11a7 7 0 0 1 14 0c0 5.4-7 11-7 11Z"/><circle cx="12" cy="10" r="2.5"/></svg></span>
            <div>
              <b>Factory &amp; Office</b>
              <span>Plot C-17 to C-19, UPSIDC Industrial Area,<br>Textile Zone, Rooma, Kanpur — 208008,<br>Uttar Pradesh, India</span>
            </div>
          </div>
          <div class="ct-item">
            <span class="ct-ic"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/></svg></span>
            <div>
              <b>Business Hours</b>
              <span>Monday – Saturday, 9:00 – 18:00 IST</span>
            </div>
          </div>
        </div>

        <iframe
          class="ct-map"
          title="SB Fall Protection location, Rooma, Kanpur"
          src="https://www.google.com/maps?q=UPSIDC+Industrial+Area+Rooma+Kanpur+208008&output=embed"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>

      <form class="quote-card reveal" id="quoteForm">
        <h3>Request a <em>Free Quote</em></h3>
        <p class="respond">We typically respond within one business day.</p>
        <div class="f-fields">
          <input name="fname" required autocomplete="given-name" placeholder="First Name" aria-label="First Name">
          <input name="lname" autocomplete="family-name" placeholder="Last Name" aria-label="Last Name">
          <input name="company" autocomplete="organization" placeholder="Company" aria-label="Company">
          <input name="phone" type="tel" autocomplete="tel" placeholder="Phone Number" aria-label="Phone Number">
          <input class="full" name="email" type="email" required autocomplete="email" placeholder="Email Address" aria-label="Email Address">
          <input class="full" name="country" placeholder="Delivery country / port" aria-label="Delivery country or port">
          <select class="full" name="type" required aria-label="Product category">
            <option value="" selected disabled>Select Product Category…</option>
            {categories.map((c) => <option>{c.name}</option>)}
            <option>Other (please mention in message)</option>
          </select>
          <textarea class="full" name="msg" placeholder="Product codes, quantities and any custom requirement…" required aria-label="Message"></textarea>
        </div>
        <button class="btn btn-orange" type="submit">Send Request</button>
        <p class="pd-note" style="margin-top:14px">
          Prefer email? Write to
          <a href="mailto:sales@sbfallprotection.com" style="color:var(--orange);font-weight:600">sales@sbfallprotection.com</a>
          and the team will get back to you with the latest catalogue.
        </p>
      </form>
    </div>
  </section>
</Base>
