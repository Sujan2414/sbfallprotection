---
import Base from '../layouts/Base.astro';
/**
 * Served for any path that does not exist — including the retired console
 * addresses, deliberately. A redirect from /admin would tell anyone probing
 * exactly where the real console lives; a plain 404 tells them nothing.
 */
---
<Base
  title="Page not found — SB Fall Protection"
  description="That page does not exist. Browse the SB Fall Protection catalogue, read the blog, or get in touch."
>
  <section class="nf">
    <div class="wrap nf-in">
      <span class="label">404</span>
      <h1>This page has <em>come loose.</em></h1>
      <p>The address may be mistyped, or the page has moved. Everything you're
        looking for is a click away below.</p>
      <div class="nf-btns">
        <a class="btn btn-orange" href="/">Back to home</a>
        <a class="btn btn-line" href="/products">Browse products</a>
        <a class="btn btn-line" href="/contact">Contact us</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf{padding:140px 0 110px;background:var(--white);text-align:center}
  .nf-in{max-width:640px;margin:0 auto}
  .nf .label{font-size:15px;letter-spacing:.14em}
  .nf h1{font-size:clamp(34px,6vw,60px);font-weight:600;letter-spacing:-.035em;margin-top:14px;line-height:1.05}
  .nf h1 em{font-style:normal;color:var(--orange)}
  .nf p{margin-top:18px;color:var(--gray);font-size:16.5px;line-height:1.65}
  .nf-btns{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-top:32px}
  @media(max-width:600px){
    .nf{padding:110px 0 80px}
    .nf-btns{flex-direction:column;align-items:stretch}
    .nf-btns .btn{justify-content:center}
  }
</style>
