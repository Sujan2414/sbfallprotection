---
const { home = false } = Astro.props;
---
<nav>
  <div class="wrap nav-in">
    <a class="brand" href="/">
      <img src="/assets/sb-logo.png" alt="SB Fall Protection logo" width="44" height="44">
      <b>SB Fall Protection</b>
    </a>
    <div class="nav-links">
      <a href="/products">Products</a>
      <a href="/about">About</a>
      <a href="/blog">Blog</a>
      <a href="/export-markets">Export Markets</a>
    </div>
    <div class="nav-right">
      <a class="btn btn-orange nav-quote" href="/contact">Contact Now</a>
      <button class="nav-burger" id="navBurger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="navPanel">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
  <!-- same four destinations as the desktop bar, same order, plus the CTA -->
  <div class="nav-panel" id="navPanel" hidden>
    <a href="/products">Products</a>
    <a href="/about">About</a>
    <a href="/blog">Blog</a>
    <a href="/export-markets">Export Markets</a>
    <a class="btn btn-orange" href="/contact">Contact Now</a>
  </div>
</nav>
