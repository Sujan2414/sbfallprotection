---
// Anchor links only resolve on the homepage, so prefix them with "/" elsewhere.
const { home = false } = Astro.props;
const a = (hash: string) => (home ? hash : `/${hash}`);
---
<nav>
  <div class="wrap nav-in">
    <a class="brand" href="/">
      <img src="/assets/sb-logo.png" alt="SB Fall Protection logo" width="44" height="44">
      <b>SB Fall Protection</b>
    </a>
    <div class="nav-links">
      <a href="/products">Products</a>
      <a href="/about">About</a>
      <a href="/blog">Blog</a>
      <a href={a('#markets')}>Export Markets</a>
    </div>
    <div class="nav-right">
      <a class="btn btn-orange nav-quote" href="/contact">Contact Now</a>
      <button class="nav-burger" id="navBurger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="navPanel">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
  <div class="nav-panel" id="navPanel" hidden>
    <a href="/products">Products</a>
    <a href={a('#why')}>Why SB</a>
    <a href={a('#works')}>How it Works</a>
    <a href={a('#testimonials')}>Testimonials</a>
    <a href={a('#markets')}>Export Markets</a>
    <a href="/about">About</a>
    <a href="/blog">Blog</a>
    <a href={a('#faqs')}>FAQs</a>
    <a class="btn btn-orange" href="/contact">Get Your Free Quote</a>
    <a class="nav-panel-call" href="tel:+915122406728">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z"/></svg>
      +91 512 240 6728</a>
  </div>
</nav>
