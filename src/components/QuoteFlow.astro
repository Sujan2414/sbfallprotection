---
import { getCategories } from '../lib/catalog';
const categories = getCategories();
/** Optional: pre-selects the category and mentions a SKU (product pages). */
const { sku = '', category = '' } = Astro.props;

// The anon key is designed to be public: RLS lets it insert enquiries and read
// the catalogue, nothing else (verified). Absent it, the flow falls back to email.
const sbUrl = import.meta.env.SUPABASE_URL ?? process.env.SUPABASE_URL ?? '';
const sbKey = import.meta.env.SUPABASE_ANON_KEY ?? process.env.SUPABASE_ANON_KEY ?? '';
---
<div class="flow" id="quoteFlow" data-sku={sku} data-category={category}
     data-sb-url={sbUrl} data-sb-key={sbKey}>
  <div class="flow-top">
    <span class="flow-avatar">
      <img src="/assets/sb-logo.png" alt="" width="30" height="30">
    </span>
    <div class="flow-who">
      <b>SB Sales Team</b>
      <span class="flow-status"><i class="dot"></i>Typically replies within one business day</span>
    </div>
    <!-- one path with an escape hatch: the chat by default, a plain form on request -->
    <button class="flow-mode" id="flowMode" type="button" aria-pressed="false">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h16M4 12h16M4 19h10"/></svg>
      <span>Use a form</span>
    </button>
  </div>

  <div class="flow-body" id="flowBody" aria-live="polite"></div>

  <div class="flow-foot" id="flowFoot"></div>

  <form class="flow-form" id="flowForm" hidden novalidate>
    <div class="flow-form-grid">
      <label><span>Name</span><input name="name" autocomplete="name" required placeholder="Full name"></label>
      <label><span>Company</span><input name="company" autocomplete="organization" placeholder="Optional"></label>
      <label><span>Email</span><input name="email" type="email" autocomplete="email" required placeholder="you@company.com"></label>
      <label><span>Phone</span><input name="phone" type="tel" autocomplete="tel" placeholder="Optional"></label>
      <label><span>Deliver to</span><input name="country" required placeholder="Country or port"></label>
      <label><span>Category</span>
        <select name="category" required>
          <option value="">Choose…</option>
          {categories.map((c) => <option value={c.name} selected={c.name === category}>{c.name}</option>)}
          <option value="Something else">Something else</option>
        </select>
      </label>
      <label class="wide"><span>Requirement</span>
        <textarea name="detail" required rows="3" placeholder="Product codes and quantities — rough numbers are fine"></textarea>
      </label>
    </div>
    <button class="btn btn-orange flow-form-send" type="submit">Send request</button>
    <p class="flow-form-err" id="flowFormErr" hidden></p>
  </form>

  <!-- category list for the chips; a <template> would be inert to querySelectorAll -->
  <script type="application/json" id="flowCats" set:html={JSON.stringify(categories.map((c) => c.name))}></script>
</div>

<noscript>
  <p style="margin-top:16px;font-size:14.5px;color:var(--gray)">
    Email <a href="mailto:sales@sbfallprotection.com" style="color:var(--orange);font-weight:600">sales@sbfallprotection.com</a>
    or call <a href="tel:+915122406728" style="color:var(--orange);font-weight:600">+91 512 240 6728</a> for a quotation.
  </p>
</noscript>

<script src="../scripts/quote-flow.js"></script>
