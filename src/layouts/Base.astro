---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import FloatingActions from '../components/FloatingActions.astro';

interface Props {
  title: string;
  description?: string;
  /** true only on the homepage, where in-page #anchors resolve locally */
  home?: boolean;
  image?: string;
}

const {
  title,
  description = 'SB Fall Protection manufactures and exports certified fall-protection and personal protective equipment from a 145,000 sq ft facility in Kanpur, India. ISO 9001:2015 certified, SEDEX audited.',
  home = false,
  image = '/assets/hero-harness.jpg',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <link rel="icon" href="/assets/sb-logo.png">

  <meta property="og:type" content="website">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={new URL(image, Astro.site).href}>
  <meta property="og:url" content={canonical}>
  <meta name="twitter:card" content="summary_large_image">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap">
</head>
<body>
  <Nav home={home} />
  <slot />
  <Footer home={home} />
  <FloatingActions />
  <script src="../scripts/site.js"></script>
</body>
</html>
